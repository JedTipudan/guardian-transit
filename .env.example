# ------------------------------------------------------------------
# Guardian Transit — environment template
# Copy to `.env` (never commit the real file).
# ------------------------------------------------------------------

# --- Runtime -------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database ------------------------------------------------------
DATABASE_URL=postgresql://postgres:BxuEDsPpZfkVGwbYVMoFikJoTkFDSGma@postgres.railway.internal:5432/railway

# --- Auth ----------------------------------------------------------
# Required. Use a long random string, e.g. `openssl rand -hex 48`
AUTH_SECRET=c85dcbd9fa9c5fc230897aba020546ae05cda152733576084f2b1df7ab615eca3caea69fe777d07f5ccd88f43d0526e5
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# --- Phone OTP -----------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# dev | log | twilio | custom
SMS_PROVIDER=dev
SMS_PROVIDER_KEY=
SMS_PROVIDER_SECRET=
SMS_FROM_NUMBER=GuardianTransit

# --- Maps ----------------------------------------------------------
# provider: mapbox | google | HERE | osrm | openstreetmap
MAP_PROVIDER=osrm
MAP_API_KEY=
MAP_ROUTING_URL=https://router.project-osrm.org
MAP_GEOCODE_URL=https://nominatim.openstreetmap.org
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Rate limiting ------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Uploads -------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
